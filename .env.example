# Copie para `.env` (ignorado pelo git) e preencha só o que for usar.

# ollama | anthropic | openai | openrouter | huggingface
SRAG_LLM_PROVIDER=ollama

# Opcional para ollama (qwen3:8b) e anthropic (claude-opus-5-5);
# obrigatório para openai, openrouter e huggingface. Precisa suportar tool calling.
SRAG_LLM_MODEL=

# Opções com valor padrão
# SRAG_LLM_TEMPERATURE=0.0
# SRAG_LLM_MAX_TOKENS=16000
# SRAG_LLM_TIMEOUT_SECONDS=120
# SRAG_LLM_MAX_RETRIES=2
# SRAG_OLLAMA_BASE_URL=http://localhost:11434

# Chave do provedor escolhido
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=